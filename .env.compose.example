# Copy this file to .env.compose and replace all local-only secrets.
# Keep both database passwords URL-safe (letters, digits, hyphens, underscores).
POSTGRES_DB=gymcoach
POSTGRES_USER=gymcoach_admin
POSTGRES_PASSWORD=replace-with-a-local-url-safe-password
CLAVE_FIRMA=replace-with-a-random-local-signing-key
API_DB_PASSWORD=replace-with-a-local-url-safe-api-password
PUERTO=8090
TIEMPO_ESPERA_SEGUNDOS=5
