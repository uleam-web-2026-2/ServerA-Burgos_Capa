# Copy this file to .env.compose and replace both local-only secrets.
# Keep POSTGRES_PASSWORD URL-safe (letters, digits, hyphens, underscores).
POSTGRES_DB=gymcoach
POSTGRES_USER=gymcoach
POSTGRES_PASSWORD=replace-with-a-local-url-safe-password
CLAVE_FIRMA=replace-with-a-random-local-signing-key
PUERTO=8080
TIEMPO_ESPERA_SEGUNDOS=5
