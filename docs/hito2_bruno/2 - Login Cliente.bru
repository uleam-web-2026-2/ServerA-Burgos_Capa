meta {
  name: 2 - Login Cliente
  type: http
  seq: 2
}

post {
  url: {{base_url}}/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "usuario": "ana",
    "clave": "ana-2026"
  }
}

vars:pre-request {
  base_url: http://localhost:8080
}

script:post-response {
  test("Login de Ana responde 200 y entrega token", function() {
    expect(res.status).to.equal(200);
    expect(res.body.datos.token).to.be.a("string").and.not.empty;
  });
  bru.setEnvVar("token_cliente", res.body.datos.token);
}
