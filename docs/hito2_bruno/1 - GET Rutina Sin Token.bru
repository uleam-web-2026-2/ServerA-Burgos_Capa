meta {
  name: 1 - GET Rutina Sin Token
  type: http
  seq: 1
}

get {
  url: {{base_url}}/rutinas/{{rutina_id}}
  body: none
  auth: none
}

vars:pre-request {
  rutina_id: rutina_id
  base_url: http://localhost:8080
}

script:post-response {
  test("Sin token responde 401", function() {
    expect(res.status).to.equal(401);
  });
}
