meta {
  name: Preparación - Login Entrenador
  type: http
  seq: 1
}

post {
  url: {{base_url}}/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "usuario": "luis",
    "clave": "luis-2026"
  }
}

vars:pre-request {
  base_url: http://localhost:8080
}

script:post-response {
  test("Login de Luis responde 200 y entrega token", function() {
    expect(res.status).to.equal(200);
    expect(res.body.datos.token).to.be.a("string").and.not.empty;
  });
  bru.setEnvVar("token_entrenador", res.body.datos.token);
}
