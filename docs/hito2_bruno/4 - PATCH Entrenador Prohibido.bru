meta {
  name: 4 - PATCH Entrenador Prohibido
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/rutinas/{{rutina_id}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token_entrenador}}
}

body:json {
  {
    "estado": "en_progreso"
  }
}

script:post-response {
  test("El entrenador no puede cambiar el estado: 403", function() {
    expect(res.status).to.equal(403);
  });
}
